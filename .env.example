# Supabase project credentials (fill these in when ready)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key — use ONLY on the server (admin operations). Never expose in browser.
SUPABASE_SERVICE_KEY=your-service-role-key

# Admin panel password (change this). Used to log into /admin.
ADMIN_PASSWORD=ChangeMe123
